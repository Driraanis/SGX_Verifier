#Gramine manifest template for the enclave-side verification service under SGX.
#hand-written source; the .manifest and .manifest.sgx outputs are generated by
#gramine-manifest then gramine-sgx-sign and are not tracked. the service takes
#presentations over a loopback HTTP endpoint and verifies them in the enclave

#arch library dir for this x86-64 VM. set here because this Gramine build doesn't
#auto-inject arch_libdir into the template namespace
{% set arch_libdir = "/lib/x86_64-linux-gnu" %}

#entrypoint: the gramine-ratls wrapper. it makes an RA-TLS key/cert pair (with a
#live SGX quote in a cert extension) at the given paths, then execs the command after "--"
libos.entrypoint = "/usr/bin/gramine-ratls"

#gramine-ratls writes the cert/key to /ratls, then execs the service. the cert at
#/ratls/ratls.crt carries this enclave's live MRENCLAVE
loader.argv = ["gramine-ratls", "/ratls/ratls.crt", "/ratls/ratls.key", "--", "python3.13", "/home/anis/SGX_Verifier/enclave/enclave_server.py"]

#Gramine's own diagnostics; quiet unless log_level is passed to gramine-manifest
loader.log_level = "{{ log_level | default('error') }}"

#environment seen by the script inside the enclave
loader.env.LD_LIBRARY_PATH = "/lib:{{ arch_libdir }}:/usr/lib:/usr/{{ arch_libdir }}"
#PYTHONPATH points at the venv site-packages, where flask, indy_vdr and anoncreds
#are found from inside the enclave
loader.env.PYTHONPATH = "/home/anis/SGX_Verifier/aries-cloudagent-python/venv/lib/python3.13/site-packages"
#genesis is pinned: the ledger trust root is read from a file measured into
#MRENCLAVE (see sgx.trusted_files below), not fetched at runtime, so the untrusted
#host cannot substitute the pool the enclave trusts
loader.env.GENESIS_PATH = "/home/anis/SGX_Verifier/enclave/bcovrin_genesis.txn"

#filesystem mounts. the Gramine runtime dir gives the patched loader/libc; the
#host system dirs give Python's stdlib and the C libraries
fs.mounts = [
  { path = "/lib", uri = "file:{{ gramine.runtimedir() }}" },
  { path = "{{ arch_libdir }}", uri = "file:{{ arch_libdir }}" },
  { path = "/usr", uri = "file:/usr" },
  { path = "/etc", uri = "file:/etc" },
  { path = "/tmp", uri = "file:/tmp" },
  #the RA-TLS pair lives here: tmpfs is in-enclave memory, so the private key is
  #never written through to the host filesystem. gramine-ratls execs the service
  #rather than forking it, so the same process keeps this mount
  { type = "tmpfs", path = "/ratls" },
  #the enclave working dir: the service script
  { path = "/home/anis/SGX_Verifier/enclave", uri = "file:/home/anis/SGX_Verifier/enclave" },
  #the venv site-packages with the Python dependencies
  { path = "/home/anis/SGX_Verifier/aries-cloudagent-python/venv/lib/python3.13/site-packages", uri = "file:/home/anis/SGX_Verifier/aries-cloudagent-python/venv/lib/python3.13/site-packages" },
]

#SGX settings
sgx.debug = false
sgx.enclave_size = "1G"
sgx.max_threads = 16

#enable DCAP remote attestation. this makes Gramine expose the
#/dev/attestation/user_report_data and /dev/attestation/quote pseudo-files that
#get_quote() reads: writing 64 bytes of report data and reading the quote yields a
#fresh SGX quote (report data + MRENCLAVE) signed via Intel DCAP, verifiable
#against Intel PCS. without this, those pseudo-files are absent
sgx.remote_attestation = "dcap"

#files measured into MRENCLAVE: code that must not change unobserved
sgx.trusted_files = [
  #the gramine-ratls entrypoint wrapper, measured in so it can't be swapped
  "file:/usr/bin/gramine-ratls",
  #the Python interpreter, needed as a trusted file so libos can exec it
  "file:/usr/bin/python3.13",
  "file:{{ gramine.runtimedir() }}/",
  "file:{{ arch_libdir }}/",
  "file:/usr/{{ arch_libdir }}/",
  "file:/usr/lib/python3.13/",
  #the ssl module's _ssl extension (used by the RA-TLS server) loads from here, so
  #the dynamic-extension modules must be measured in
  "file:/usr/lib/python3.13/lib-dynload/",
  #Werkzeug's dev-server logger imports colorama from the system dist-packages
  "file:/usr/lib/python3/dist-packages/",
  "file:/home/anis/SGX_Verifier/aries-cloudagent-python/venv/lib/python3.13/site-packages/",
  #the pinned BCovrin genesis: the ledger trust root, measured in so the host
  #cannot substitute a different pool without changing MRENCLAVE (read_genesis)
  "file:/home/anis/SGX_Verifier/enclave/bcovrin_genesis.txn",
  "file:/home/anis/SGX_Verifier/enclave/enclave_server.py",
]

#allowed but not measured: host state the enclave reads at runtime and cannot hash
sgx.allowed_files = [
  #system config: resolv.conf, hosts, certs metadata
  "file:/etc/",
  #scratch space Python and its libraries use
  "file:/tmp/",
]
